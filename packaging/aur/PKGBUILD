# Maintainer: BobBoba <24909845+BobBoba@users.noreply.github.com>
pkgname=evenband-lv2
pkgver=1.2.0
pkgrel=1
pkgdesc='Five-band tonal compressor (LV2) with a full control window, preset manager and bypass'
arch=('x86_64' 'aarch64')
url='https://github.com/BobBoba/evenband'
license=('MIT')
depends=('glibc' 'python' 'cairo' 'libx11' 'gtk3' 'glib2')
makedepends=('lv2' 'pkgconf')
optdepends=('carla: host the plugin on its own or in a rack'
            'kdialog: file chooser for importing presets (KDE)'
            'zenity: file chooser for importing presets (GTK)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('02a3a4c15a39ba22f9b7d2db9f21de55afbc440b062fb22d905be7463040e03e')

build() {
  cd "evenband-$pkgver"
  make
}

package() {
  cd "evenband-$pkgver"
  make DESTDIR="$pkgdir" LV2DIR=/usr/lib/lv2 install
  install -Dm755 tools/amx2lv2.py "$pkgdir/usr/bin/evenband-amx2lv2"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md SPEC.md -t "$pkgdir/usr/share/doc/$pkgname"
}
